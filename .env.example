# ==========================================
# AgriAssist - Environment Configuration
# ==========================================

# Application
APP_NAME=Agricultural Assistant Platform
APP_ENV=development
SECRET_KEY=your-secret-key-change-this-in-production
DEBUG=True

# Database
# Default: SQLite (Fallback automatically applies if PostgreSQL fails)
DATABASE_URL=sqlite:///./agritech.db
# Or remote PostgreSQL / Supabase:
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-region.pooler.supabase.com:6543/postgres

# Supabase Storage (Optional - falls back to ./local_s3 if empty or unavailable)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# File Upload
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=uploads

# JWT Authentication
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# AI APIs
# Google Gemini / GenAI API Key
GOOGLE_API_KEY=
GEMINI_API_KEY=
GEMINI_API_KEY_POOL=

# Groq API
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b

# Neo4j Graph Database
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=your-neo4j-password
NEO4J_DATABASE=neo4j

# Twilio Voice & SMS
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_API_KEY=
TWILIO_API_SECRET=
TWILIO_TWIML_APP_SID=
